# vim: filetype=meson

# A relative path means it gets appended to prefix.
option(
  'profile-dir',
  type : 'string',
  value : 'etc/profile.d',
  description : 'the path to install shell profile files',
)

option(
  'rust-eval',
  type : 'feature',
  value : 'disabled',
  description : 'link the in-tree Rust evaluator (rust/nix-eval-rs) behind eval-backend = rust',
)
